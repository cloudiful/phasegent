{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "phasegent",
  "version": "2.11.0",
  "identifier": "com.cloud1ful.phasegent",
  "build": {
    "beforeBuildCommand": "bun run validate",
    "frontendDist": "frontend/dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "phasegent",
        "width": 1024,
        "height": 768
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: https://asset.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
