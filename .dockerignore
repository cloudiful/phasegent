# Keep the build context small and deterministic. The runtime image
# copies a prebuilt CLI binary staged by CI at ci-image-input/phasegent,
# so only that path (plus Dockerfile itself) is needed at build time.
target/
.git/
.github/
dist/
release/
frontend/node_modules/
frontend/dist/
node_modules/
*.log
.phasegent/
*.token
*.tokens
# ci-image-input/ holds the per-arch release binary staged by CI and must
# never be excluded from the build context.
!ci-image-input/
!ci-image-input/phasegent
