/target/
Cargo.lock
*.log

# Default scratch root for Cargo workflows: .cargo/config.toml supplies it as
# the TMPDIR/TMP/TEMP fallback whenever the caller exports none, while a
# session may point its own temp variables elsewhere. The tracked .gitkeep
# keeps the directory present in every clone and worktree, so the first
# compiler or cargo wrapper invocation never sees a missing temp root.
/.scratch/*
!/.scratch/.gitkeep

# Local phasegent credentials and configuration.
.phasegent/
*.token
*.tokens

# Public release local outputs (generated by release workflow artifacts).
dist/
release/

# Frontend dependencies and generated declarations (phase 2).
node_modules/
bun.lock
frontend/auto-imports.d.ts
frontend/components.d.ts

gen/
