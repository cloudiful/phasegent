{
  "name": "phasegent",
  "private": true,
  "version": "2.21.7",
  "type": "module",
  "description": "phasegent desktop shell (Electron: Vue 3 + Nuxt UI + Tailwind CSS v4 frontend, Rust companion backend).",
  "author": "phasegent",
  "main": "electron/dist/main.cjs",
  "scripts": {
    "dev": "vite --config frontend/vite.config.ts",
    "build": "bun run build-only && bun run typecheck",
    "build-only": "vite build --config frontend/vite.config.ts",
    "typecheck": "vue-tsc --noEmit -p frontend/tsconfig.json && tsc --noEmit -p tsconfig.electron.json",
    "lint": "eslint --config frontend/eslint.config.mjs frontend/src frontend/tests frontend/vite.config.ts",
    "test": "bun test frontend/tests electron",
    "test:electron": "bun test electron",
    "validate": "bun run build-only && bun frontend/scripts/validate-dist.mjs",
    "electron:build": "bun scripts/electron-build.mjs",
    "electron:dev": "bun scripts/electron-dev.mjs",
    "electron:backend": "bun scripts/electron-backend.mjs",
    "electron:package": "bun scripts/electron-build.mjs --dist && bun scripts/electron-backend.mjs && electron-builder --config electron-builder.yml",
    "build:plugin": "bun assets/opencode/src/build.js",
    "dist:hash": "bun scripts/dist-hash.mjs"
  },
  "dependencies": {
    "@nuxt/ui": "4.11.1",
    "tailwindcss": "4.3.3",
    "vue": "3.5.42",
    "vue-router": "5.3.1"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "26.5.1",
    "@vitejs/plugin-vue": "6.0.8",
    "bun-types": "1.4.2",
    "electron": "44.5.0",
    "electron-builder": "26.15.3",
    "eslint": "10.10.0",
    "eslint-plugin-vue": "10.11.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.70.0",
    "vite": "8.3.0",
    "vue-tsc": "3.3.11"
  }
}
